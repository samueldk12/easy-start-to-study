# =============================================================================
# ENVIRONMENT CONFIGURATION FOR LOCAL EVENT-DRIVEN LAKEHOUSE
# =============================================================================

# PostgreSQL OLTP (mapped to 5434 on host to avoid conflict with existing services)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=oltp_db
POSTGRES_PORT=5434

# MinIO (S3 Lakehouse Storage)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_LAKEHOUSE=lakehouse
MINIO_BUCKET_WAREHOUSE=warehouse

# Kafka & Schema Registry
KAFKA_PORT=9092
SCHEMA_REGISTRY_PORT=8086
KAFKA_CONNECT_PORT=8083

# Iceberg REST Catalog
ICEBERG_REST_PORT=8181

# Trino Query Engine
TRINO_PORT=8085

# Spark
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8082

# Airflow
AIRFLOW_WEBSERVER_PORT=8088
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin
